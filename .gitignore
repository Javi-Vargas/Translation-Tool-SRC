frontend/deb/

# Model cache (never commit ~15 GB of weights)
**/models--*/
*.safetensors
*.incomplete

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
*.swp
